{
  "name": "markdown-footnotes",
  "version": "0.2.0",
  "displayName": "Markdown Footnotes",
  "description": "Adds [^footnote] syntax support to VS Code's built-in markdown preview",
  "keywords": [
    "markdown",
    "footnotes",
    "md",
    "documentation"
  ],
  "icon": "logo/logox128.png",
  "publisher": "bierner",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/mjbvz/vscode-markdown-footnotes.git"
  },
  "bugs": {
    "url": "https://github.com/mjbvz/vscode-markdown-footnotes/issues"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:markdown-footnotes.tidyFootnotes",
    "onCommand:markdown-footnotes.insertNamedFootnote",
    "onCommand:markdown-footnotes.insertAutoNumberedFootnote"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "commands": [
      {
        "command": "markdown-footnotes.tidyFootnotes",
        "title": "Tidy Footnotes",
        "category": "Markdown"
      },
      {
        "command": "markdown-footnotes.insertNamedFootnote",
        "title": "Insert Named Footnote",
        "category": "Markdown"
      },
      {
        "command": "markdown-footnotes.insertAutoNumberedFootnote",
        "title": "Insert Auto-Numbered Footnote",
        "category": "Markdown"
      }
    ]
  },
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild  src/extension.js --format=cjs --bundle --minify --outfile=dist/extension.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.60",
    "esbuild": "^0.15.14"
  },
  "dependencies": {
    "markdown-it-footnote": "^3.0.3"
  }
}
